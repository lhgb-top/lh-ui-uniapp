{
  "name": "lh-ui-uniapp",
  "appid": "",
  "description": "lh-ui 家族 uni-app 组件库演示工程（不发包）",
  "versionName": "0.0.0",
  "versionCode": "0",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
