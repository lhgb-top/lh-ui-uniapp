  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "minified": true,
      "postcss": true
    },
    "usingComponents": true,
    "mergeVirtualHostAttributes": true
  },
  "h5": {
    "title": "lh-ui uniapp",
    "router": { "mode": "hash" }
  },
  "vueVersion": "3"
